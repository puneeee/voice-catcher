# Required for persisted cloud history and WhatsApp delivery
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/voice-catcher?retryWrites=true&w=majority
PILOT_API_TOKEN=replace-with-a-long-random-secret

# Required for AI intent classification; keep this only on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for official WhatsApp Cloud API P2 messages.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_E164=
WHATSAPP_TEMPLATE_NAME=voice_catcher_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en_US
PORT=3000
